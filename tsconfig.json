{
  "compilerOptions": {
    "noEmit": true,
    "module": "nodenext",
    "moduleResolution": "nodenext",
    "paths": {
      "@codemirror-treesitter/language": ["./packages/language/src/index.ts"],
      "@codemirror-treesitter/language-data": ["./packages/language-data/src/index.ts"],
      "@codemirror-treesitter/theme-gruvbox": ["./packages/theme-gruvbox/src/index.ts"],
      "@codemirror-treesitter/commands": ["./packages/commands/src/index.ts"],
      "@codemirror-treesitter/autocomplete": ["./packages/autocomplete/src/index.ts"],
      "@codemirror-treesitter/basic-setup": ["./packages/codemirror/src/index.ts"],
      "@codemirror-treesitter/merge": ["./packages/merge/src/index.ts"],
      "@codemirror-treesitter/lsp-client": ["./packages/lsp-client/src/index.ts"],
      "@codemirror-treesitter/typora-runtime/fixtures": [
        "./packages/typora-runtime/src/fixtures/index.ts"
      ],
      "@codemirror-treesitter/typora-runtime/register": [
        "./packages/typora-runtime/src/register.ts"
      ],
      "@codemirror-treesitter/typora-runtime": ["./packages/typora-runtime/src/index.ts"]

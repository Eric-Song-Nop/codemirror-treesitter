{
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    "module": "esnext",
    "moduleResolution": "bundler",
    "paths": {
      "@codemirror-treesitter/autocomplete": ["./packages/autocomplete/src/index.ts"],
      "@codemirror-treesitter/basic-setup": ["./packages/codemirror/src/index.ts"],
      "@codemirror-treesitter/commands": ["./packages/commands/src/index.ts"],
      "@codemirror-treesitter/language": ["./packages/language/src/index.ts"],
      "@codemirror-treesitter/language-data": ["./packages/language-data/src/index.ts"],
      "@codemirror-treesitter/live-md": ["./packages/live-md/src/index.ts"],
      "@codemirror-treesitter/live-md/fixtures": ["./packages/live-md/src/fixtures/index.ts"],
      "@codemirror-treesitter/live-md/register": ["./packages/live-md/src/register.ts"],
      "@codemirror-treesitter/live-md-loro": ["./packages/live-md-loro/src/index.ts"],
      "@codemirror-treesitter/lsp-client": ["./packages/lsp-client/src/index.ts"],
      "@codemirror-treesitter/merge": ["./packages/merge/src/index.ts"],
      "@codemirror-treesitter/theme-palettes": ["./packages/theme-palettes/src/index.ts"],
      "@codemirror-treesitter/theme-gruvbox": ["./packages/theme-gruvbox/src/index.ts"],
      "loro-codemirror": ["./node_modules/loro-codemirror/src/index.ts"]
    },
    "types": ["vite-plus/client"],
    "noFallthroughCasesInSwitch": true
  }
}

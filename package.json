{
  "name": "codemirror-treesitter",
  "version": "0.0.0",
  "private": true,
  "workspaces": [
    "packages/*",
    "apps/*",
    "tools/*",
    "vendor/web-tree-sitter"
  ],
  "type": "module",
  "scripts": {
    "audit": "node tools/audit.mjs",
    "package:validate": "node tools/package-validate.mjs",
    "ready": "vp check && vp run verify:web-tree-sitter && vp run local-md-workspace#i18n:check && vp run -r test && vp run -r build && vp run audit",
    "verify:web-tree-sitter": "node tools/verify-web-tree-sitter-cursor-range.mjs"
  },
  "dependencies": {
    "@codemirror-treesitter/web-tree-sitter": "file:vendor/web-tree-sitter"
  },
  "devDependencies": {
    "@arethetypeswrong/cli": "^0.18.4",
    "publint": "^0.3.21",
    "vite-plus": "catalog:"
  },
  "overrides": {
    "@codemirror-treesitter/web-tree-sitter": "file:vendor/web-tree-sitter",
    "vite": "catalog:",
    "vitest": "catalog:"
  },
  "engines": {
    "node": ">=26.0.0"
  },
  "packageManager": "bun@1.3.14",
  "catalog": {
    "vite": "npm:@voidzero-dev/vite-plus-core@latest",
    "vitest": "npm:@voidzero-dev/vite-plus-test@latest",
    "vite-plus": "latest"
  }
}

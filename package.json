{
  "name": "codemirror-treesitter",
  "version": "0.0.0",
  "private": true,
  "workspaces": [
    "packages/*",
    "apps/*",
    "tools/*"
  ],
  "type": "module",
  "scripts": {
    "audit": "node tools/audit.mjs",
    "ready": "vp check && vp run verify:web-tree-sitter && vp run local-md-workspace#i18n:check && vp run -r test && vp run -r build && vp run audit",
    "verify:web-tree-sitter": "node tools/verify-web-tree-sitter-cursor-range.mjs"
  },
  "dependencies": {
    "web-tree-sitter": "file:vendor/web-tree-sitter"
  },
  "devDependencies": {
    "effect": "4.0.0-beta.107",
    "vite-plus": "catalog:"
  },
  "overrides": {
    "vite": "catalog:",
    "vitest": "catalog:",
    "web-tree-sitter": "file:vendor/web-tree-sitter"
  },
  "engines": {
    "node": ">=26.0.0"
  },
  "packageManager": "bun@1.3.14",
  "catalog": {
    "vite": "npm:@voidzero-dev/vite-plus-core@0.1.24",
    "vitest": "npm:@voidzero-dev/vite-plus-test@0.1.24",
    "vite-plus": "0.1.24"
  }
}

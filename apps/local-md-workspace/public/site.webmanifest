{
  "id": "/",
  "name": "Grove",
  "short_name": "Grove",
  "description": "A local-first Markdown workspace for editing Grove documents.",
  "start_url": "/",
  "scope": "/",
  "display": "standalone",
  "background_color": "#282828",
  "theme_color": "#1d2021",
  "categories": ["productivity", "utilities"],
  "share_target": {
    "action": "/share",
    "method": "POST",
    "enctype": "multipart/form-data",
    "params": {
      "title": "title",
      "text": "text",
      "url": "url",
      "files": {
        "name": "files",
        "accept": ["text/markdown", "text/plain", ".md", ".markdown"]
      }
    }
  },
  "icons": [
    {
      "src": "/icon-192.png",
      "sizes": "192x192",
      "type": "image/png",
      "purpose": "any maskable"
    },
    {
      "src": "/icon-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "any maskable"
    }
  ]
}

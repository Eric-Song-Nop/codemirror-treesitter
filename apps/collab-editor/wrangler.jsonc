{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "collab-editor",
  "main": "./src/worker.ts",
  "compatibility_date": "2026-05-28",
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"],
  },
  "durable_objects": {
    "bindings": [
      {
        "name": "COLLAB_CREATE_QUOTA",
        "class_name": "CollabCreateQuota",
      },
      {
        "name": "COLLAB_ROOMS",
        "class_name": "CollabRoom",
      },
    ],
  },
  "ratelimits": [
    {
      "name": "CREATE_SHARE_RATE_LIMITER",
      "namespace_id": "43544",
      "simple": {
        "limit": 30,
        "period": 60,
      },
    },
    {
      "name": "SHARE_SESSION_RATE_LIMITER",
      "namespace_id": "43545",
      "simple": {
        "limit": 120,
        "period": 60,
      },
    },
    {
      "name": "SHARE_WEBSOCKET_RATE_LIMITER",
      "namespace_id": "43546",
      "simple": {
        "limit": 120,
        "period": 60,
      },
    },
  ],
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": ["CollabRoom"],
    },
    {
      "tag": "v2",
      "new_sqlite_classes": ["CollabCreateQuota"],
    },
  ],
  "vars": {
    // Optional comma-separated CORS/WebSocket Origin allowlist. Blank keeps
    // the permissive reflect-any-origin behavior.
    "ALLOWED_ORIGINS": "",
  },
  "observability": {
    "enabled": true,
  },
}

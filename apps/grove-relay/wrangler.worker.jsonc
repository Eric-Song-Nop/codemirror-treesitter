{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "grove-relay",
  "main": "./dist/grove_relay/index.js",
  "compatibility_date": "2026-05-28",
  "compatibility_flags": ["nodejs_compat"],
  "routes": [
    {
      "pattern": "relay.grovemd.net",
      "zone_name": "grovemd.net",
      "custom_domain": true,
    },
  ],
  "durable_objects": {
    "bindings": [
      {
        "name": "GROVE_SHARE_ROOMS",
        "class_name": "GroveShareRoom",
      },
    ],
  },
  "ratelimits": [
    {
      "name": "CREATE_SHARE_RATE_LIMITER",
      "namespace_id": "43541",
      "simple": {
        "limit": 30,
        "period": 60,
      },
    },
  ],
  "analytics_engine_datasets": [
    {
      "binding": "GROVE_METRICS",
      "dataset": "grove_relay_metrics",
    },
  ],
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": ["GroveShareRoom"],
    },
  ],
  "observability": {
    "enabled": true,
    "logs": {
      "enabled": true,
      "head_sampling_rate": 1,
    },
    "traces": {
      "enabled": true,
      "head_sampling_rate": 0.05,
    },
  },
}

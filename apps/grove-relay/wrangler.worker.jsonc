{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "grove-relay",
  "main": "./dist/grove_relay/index.js",
  "compatibility_date": "2026-05-28",
  "compatibility_flags": ["nodejs_compat"],
  "durable_objects": {
    "bindings": [
      {
        "name": "GROVE_SHARE_ROOMS",
        "class_name": "GroveShareRoom",
      },
    ],
  },
  "ratelimits": [
    {
      "name": "CREATE_SHARE_RATE_LIMITER",
      "namespace_id": "43541",
      "simple": {
        "limit": 30,
        "period": 60,
      },
    },
  ],
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": ["GroveShareRoom"],
    },
  ],
  "observability": {
    "enabled": true,
  },
}

+it("REVIEW differential edits", async () => {
+  const blocks = [
+    "paragraph **bold** and _italic_",
+    "- item\n- second",
+    "> quote\n> more",
+    "# heading",
+    "```\ncode\n```",
+    "| a | b |\n| --- | --- |\n| x | y |",
+    "[label](https://example.com)",
+    "---",
+    "    indented",
+    "- [ ] task",
+    "<div>\nhtml\n</div>",
+  ];
+  let seed = 731;
+  const rand = (n: number) => {
+    seed = (Math.imul(seed, 1664525) + 1013904223) >>> 0;
+    return seed % n;
+  };
+  const inserts = ["\n", "\n\n", " ", "#", "> ", "- ", "`", "```\n", "*", "|", "x", "", "\n---\n"];
+  for (let trial = 0; trial < 12; trial++) {
+    let doc =
+      Array.from({ length: 12 }, () => blocks[rand(blocks.length)]).join("\n\n") + "\n\nanchor";
+    let view = await markdownAnalysisView(doc, "anchor");
+    try {
+      for (let edit = 0; edit < 25; edit++) {
+        let before = view.state.doc.toString();
+        let from = rand(before.length + 1),
+          to = Math.min(before.length, from + rand(5));
+        let insert = inserts[rand(inserts.length)]!;
+        dispatchParsedTransaction(
+          view,
+          view.state.update({
+            changes: { from, to, insert },
+            selection: { anchor: from + insert.length },
+          }),
+        );
+        await __testFlushLiveMdAnalysis(view);
+        let local = canonicalAnalysis(view.state, __testLiveMdAnalysis({ state: view.state }));
+        let fresh = canonicalAnalysis(view.state, __testBuildCanonicalLiveMdAnalysis(view.state));
+        if (JSON.stringify(local) !== JSON.stringify(fresh))
+          console.log("REVIEW_REPRO", JSON.stringify({ before, from, to, insert, trial, edit }));
+        expect(local).toEqual(fresh);
+      }
+    } finally {
+      view.destroy();
+    }
+  }
+}, 120000);

{
  "name": "@codemirror-treesitter/live-md",
  "version": "0.0.0",
  "description": "LiveMD Markdown editor runtime built on the local tree-sitter CodeMirror packages",
  "keywords": [
    "codemirror",
    "editor",
    "live",
    "md",
    "tree-sitter",
    "typescript"
  ],
  "homepage": "https://github.com/Eric-Song-Nop/codemirror-treesitter/tree/main/packages/live-md#readme",
  "bugs": {
    "url": "https://github.com/Eric-Song-Nop/codemirror-treesitter/issues"
  },
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Eric-Song-Nop/codemirror-treesitter.git",
    "directory": "packages/live-md"
  },
  "files": [
    "dist",
    "src/style.css"
  ],
  "type": "module",
  "sideEffects": [
    "./dist/register.mjs",
    "./src/register.ts",
    "./src/style.css"
  ],
  "types": "./dist/index.d.mts",
  "exports": {
    ".": {
      "types": "./dist/index.d.mts",
      "import": "./dist/index.mjs"
    },
    "./fixtures": {
      "types": "./dist/fixtures/index.d.mts",
      "import": "./dist/fixtures/index.mjs"
    },
    "./register": {
      "types": "./dist/register.d.mts",
      "import": "./dist/register.mjs"
    },
    "./style.css": "./src/style.css",
    "./package.json": "./package.json"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "vp pack",
    "test": "vp test",
    "check": "vp check"
  },
  "dependencies": {
    "@codemirror-treesitter/autocomplete": "0.0.0",
    "@codemirror-treesitter/basic-setup": "0.0.0",
    "@codemirror-treesitter/commands": "0.0.0",
    "@codemirror-treesitter/language": "0.0.0",
    "@codemirror-treesitter/language-data": "0.0.0",
    "@codemirror-treesitter/live-md-theme": "0.0.0",
    "@codemirror/search": "^6.7.0",
    "@codemirror/state": "^6.6.0",
    "@codemirror/view": "^6.43.0",
    "beautiful-mermaid": "^1.1.3",
    "katex": "^0.17.0",
    "mermaid": "^10.9.6"
  },
  "devDependencies": {
    "@typescript/native-preview": "7.0.0-dev.20260509.2",
    "happy-dom": "^20.0.11",
    "typescript": "^6.0.3",
    "vite-plus": "0.1.22"
  }
}

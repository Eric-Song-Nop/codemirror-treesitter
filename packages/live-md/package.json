{
  "name": "@codemirror-treesitter/live-md",
  "version": "0.0.0",
  "description": "LiveMD Markdown editor runtime built on the local tree-sitter CodeMirror packages",
  "license": "MIT",
  "files": [
    "dist",
    "src/style.css"
  ],
  "type": "module",
  "sideEffects": [
    "./dist/register.mjs",
    "./src/register.ts",
    "./src/style.css"
  ],
  "types": "./dist/index.d.mts",
  "exports": {
    ".": {
      "types": "./dist/index.d.mts",
      "import": "./dist/index.mjs"
    },
    "./fixtures": {
      "types": "./dist/fixtures/index.d.mts",
      "import": "./dist/fixtures/index.mjs"
    },
    "./register": {
      "types": "./dist/register.d.mts",
      "import": "./dist/register.mjs"
    },
    "./style.css": "./src/style.css",
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "vp pack",
    "test": "vp test",
    "check": "vp check"
  },
  "dependencies": {
    "@codemirror-treesitter/autocomplete": "workspace:*",
    "@codemirror-treesitter/basic-setup": "workspace:*",
    "@codemirror-treesitter/commands": "workspace:*",
    "@codemirror-treesitter/language": "workspace:*",
    "@codemirror-treesitter/language-data": "workspace:*",
    "@codemirror-treesitter/theme-gruvbox": "workspace:*",
    "@codemirror/search": "^6.7.0",
    "@codemirror/state": "^6.6.0",
    "@codemirror/view": "^6.43.0",
    "beautiful-mermaid": "^1.1.3",
    "katex": "^0.17.0",
    "mermaid": "^10.9.4"
  },
  "devDependencies": {
    "@typescript/native-preview": "7.0.0-dev.20260509.2",
    "happy-dom": "^20.0.11",
    "typescript": "^6.0.3",
    "vite-plus": "catalog:"
  }
}
